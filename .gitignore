# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.hypothesis/

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- 敏感信息（绝不提交）----
# CodeBuddy 账号凭据（含 accessToken / refreshToken）
*.info
# 本地运行配置（含 api_key）
config.json
*.token
*.key
*.pem
secrets.*
.env
.env.*

# ---- 打包产物 ----
dist/
build/
release/
*.spec
*.manifest

# ---- 临时打包输出目录（dist 下的 exe 被运行中进程占用时的备用输出口）----
/_dist_new/
/_build_new/
/_spec_new/

# ---- 日志 / 临时文件 / 诊断输出 ----
*.log
*.pid
diag*.txt
_diag*.txt
_t*.txt
_all_tests.txt
temp_smoke*
server*.txt
nohup.out

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 一次性探针/调试脚本（本地排查用，不进版本库）----
/_ico_probe.py
/_logstat.py
/_smoke_exe.py
/_ui_test.py
/_vision_probe*.py
/_vision_result*.json
/_icon_preview.png
*.bak
